PORT=4000
# Секрет для JWT. Сгенерируйте новый:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# НЕ РАСПРОСТРАНЯЙТЕ. Если смените — все пользователи будут разлогинены (это безопасно).
JWT_SECRET=сгенерируйте_и_вставьте_сюда
# Разрешённые источники для CORS. Через запятую можно указать несколько.
# На проде обязательно https-домен, через который открывается сайт:
# Пример: https://sever.cloudpub.ru,http://localhost:5173
CLIENT_ORIGIN=https://ваш-домен.ru
# Для PostgreSQL замените datasource ниже и переключите db.js
DATABASE_SQLITE=./data/sever-1.db
